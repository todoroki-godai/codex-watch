#!/usr/bin/env bash
# codex exec を起動し、状況確認に必要な状態ファイルを残す。
#
# なぜ要るか: codex exec は ~/.codex/sessions に記録を残さない（2026-08-25 実測: 90分以内の
# セッションファイル0件）。観測できるのは stdout ログ1本だけで、「プロセスは生きているのに
# ログが無音」という はまり を検知する手段が無かった（同日、#418 のレビューが22分無音のまま
# 気づかれず放置された）。本コマンドは PID・ログ・起動時刻を状態ファイルへ書き、
# codex-status / codex-watch が無音時間を機械的に判定できるようにする。
#
# 使い方:
#   codex-review <対象ディレクトリ絶対パス> <プロンプトファイル> [ラベル]
# 出力:
#   run id を1行で返す。以降 codex-status <run id> / codex-watch <run id> で観測する。
set -euo pipefail

WORKDIR="${1:?対象ディレクトリの絶対パスを指定してください}"
PROMPT_FILE="${2:?プロンプトファイルのパスを指定してください}"
LABEL="${3:-review}"

[[ "$WORKDIR" = /* ]] || { echo "対象ディレクトリは絶対パスで指定してください: $WORKDIR" >&2; exit 2; }
[[ -d "$WORKDIR" ]] || { echo "対象ディレクトリがありません: $WORKDIR" >&2; exit 2; }
[[ -f "$PROMPT_FILE" ]] || { echo "プロンプトファイルがありません: $PROMPT_FILE" >&2; exit 2; }
# state は 1行1キーの行形式なので、改行相当の文字を含む値は偽の行を注入できる（実測: パスに
# skills_suppressed=no を仕込むと state に2行出る／2026-09-03 codex レビュー Must1: `\n` だけの
# 判定だと `\r` 等の別の行境界文字で同じ注入ができた）。`\n`/`\r` 等を個別に列挙すると回避手段が
# 無限に構成できて収束しないため、round_gate.py の `is_single_line()`（Python の
# `str.splitlines()` が行境界とみなす文字集合全体を対象にする「1行であること」という正の性質の
# 検査）を唯一の判定源として呼び出す（bash 側で別ロジックを持たせて二重管理・食い違いを作らない）。
GATE_PY="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/round_gate.py"
for _v in "$WORKDIR" "$PROMPT_FILE" "$LABEL" "${REVIEW_GOAL_CUT:-}"; do
  if ! python3 -c "
import sys
sys.path.insert(0, '$(dirname "$GATE_PY")')
from round_gate import is_single_line
sys.exit(0 if is_single_line(sys.argv[1]) else 1)
" "$_v"; then
    echo "引数に改行相当の文字を含められません（1行であること）" >&2
    exit 2
  fi
done

STATE_DIR="${CODEX_WATCH_DIR:-$HOME/.codex-watch}"
mkdir -p "$STATE_DIR"

# 巡数ゲート（review-round-cap.md / design-gate-v3.md）。
# なぜ要るか: レビューの発注は無制限に繰り返すと軍拡競争になる（rule 出所の #415/#537/#538）。
# REVIEW_TARGET 必須（none:<理由> は計測A/Bとゲート自身のprobeのみ・累計3件まで）。
# CODEX_REVIEW_NO_GATE=<理由> で例外的に迂回できるが理由必須・state に記録される。
# set -e 下では `VAR=$(cmd)` の cmd が非0を返した瞬間にシェルが即終了し、直後の `$?` 取得へ
# 到達できない（blocked=4 / indeterminate=5 / usage=2 を握りつぶして死ぬ）。ここだけ一時的に無効化する。
set +e
GATE_JSON="$(python3 "$GATE_PY" gate --target "${REVIEW_TARGET:-}" --workdir "$WORKDIR" --state-dir "$STATE_DIR" --goal-cut "${REVIEW_GOAL_CUT:-}" --json)"
GATE_EXIT=$?
set -e
if [[ -n "${CODEX_REVIEW_GATE_CHECK:-}" ]]; then
  # 判定だけ行って終了する（実発注はしない）。テスト・dry-run 用の経路。
  echo "$GATE_JSON"
  exit "$GATE_EXIT"
fi
if [[ "$GATE_EXIT" -ne 0 ]]; then
  echo "巡数ゲートで拒否されました: $GATE_JSON" >&2
  exit "$GATE_EXIT"
fi

RUN_ID="${LABEL}-$(date +%Y%m%d-%H%M%S)-$$"
LOG_FILE="$STATE_DIR/$RUN_ID.log"
STATE_FILE="$STATE_DIR/$RUN_ID.state"
# 最終メッセージだけを別ファイルへ落とす（log 全文を読まずに結論だけ取るため）。
REPORT_FILE="$STATE_DIR/$RUN_ID.report"

# 発注前の危険表現チェック（対策2 / codex-hardening-2026-08-26）。
# なぜ要るか: 2026-08-26、「防御を破る経路を構成せよ」「素通りさせる経路を実際に構成せよ」という
# 自社リポジトリへの通常レビュー依頼が、OpenAI側のセキュリティフィルタに攻撃的表現と誤認され、
# 分析完了直前（24万トークン）で遮断された（report未生成・logにも指摘0件のまま全損。
# ~/.codex-watch/rev325impl-20260826-120028-98072.log 参照）。
# ここで検出する語句リストは網羅ではなく allowlist と同型の弱さを持つ。次に出てくる別の
# 攻撃的言い回しでは素通りする。ブロックはしない（正当な用途で語が出ることもある）ので、
# 気づかせるだけの警告に留める。本命の予防策は下段の防御的文脈宣言（前置きに常時同梱）。
check_dangerous_phrasing() {
  local file="$1"
  local -a hits=()
  # パターン => 言い換え例。この対応表は例示であって網羅ではない。
  local -a patterns=(
    "破る経路:期待どおり作動しない状況を挙げてください"
    "回避経路:作動しない条件を挙げてください"
    "素通り:検査が通ってしまう状況を挙げてください"
    "偽装:実態と異なる表示になる状況を挙げてください"
    "バイパス:作動しない条件を挙げてください"
    "迂回:作動しない条件を挙げてください"
    "攻撃:意図しない挙動を挙げてください"
    "exploit:意図しない挙動を挙げてください"
    "bypass:作動しない条件を挙げてください"
  )
  local entry pat rep
  for entry in "${patterns[@]}"; do
    pat="${entry%%:*}"
    rep="${entry#*:}"
    if grep -qF "$pat" "$file" 2>/dev/null; then
      hits+=("「${pat}」→ 言い換え例:「${rep}」")
    fi
  done
  if [[ "${#hits[@]}" -gt 0 ]]; then
    echo "警告: プロンプトに攻撃的に読まれやすい表現が含まれています（このリストは網羅ではなく、次の言い回しで破れます）:" >&2
    local h
    for h in "${hits[@]}"; do
      echo "  - $h" >&2
    done
    echo "  誤検出のおそれがあるため発注はブロックしません。気づかず素通りしないよう5秒待ちます。" >&2
    echo "  無視して即座に進めるには CODEX_REVIEW_ACK_PHRASING=1 を指定してください。" >&2
    if [[ -z "${CODEX_REVIEW_ACK_PHRASING:-}" ]]; then
      sleep 5
    fi
  fi
}
check_dangerous_phrasing "$PROMPT_FILE"

# 発注プロンプトの前置き（常に付与。対策1・対策2）。
# 対策1（逐次出力・最重要）: なぜ要るか — 「最後にまとめて1回で出力する」設計だと、
# 出力直前に外部フィルタ等で遮断された場合に分析全体が失われる（上記事故で24万トークン分が全損）。
# セクションを書き終えるたびに出力させれば、遮断されても codex-watch/codex-status が読む
# log 側に途中までの内容が残る（-o の report は最終メッセージしか受け取らないため log 側のみ）。
# 対策2（防御的文脈宣言）: 自社リポジトリへの通常の品質レビューであることを明示し、
# 「防御を破る」等の表現が実際の攻撃依頼と誤認されるリスクを下げる（本命の予防策。
# 完全ではないので上の check_dangerous_phrasing による事前警告も併用する）。
# 外部スキル本文の読み込み抑止（従来からの前置き）: codex は発注のたびに
# ~/.agents/skills/gstack/review/SKILL.md（1,852行・105KB）を全文読み、それが以降のターンで
# 再送されるため 1本あたりの消費が数倍になる（2026-08-25 実測: 同一 HEAD・同一プロンプトの
# A/B で 140,514 → 37,899 トークン＝73%減。判定・[Must]/[Should] の件数と中身は同一）。
# レビュー観点は発注プロンプト側に完成条件と固定質問として書く運用なので、スキル本文は不要。
# スキル本文に頼りたい発注だけ CODEX_REVIEW_ALLOW_SKILLS=1 で外す。
case "${CODEX_REVIEW_ALLOW_SKILLS:-}" in
  1|true|yes) SKILLS_SUPPRESSED=no ;;
  *)          SKILLS_SUPPRESSED=yes ;;
esac
# 生成先は mktemp で排他確保する。第2引数が生成先と同じパスだと、リダイレクトが
# 原本を先に空にして前置きだけが届く（再発注で前回の .prompt を使い回すと起きる）。
EFFECTIVE_PROMPT="$(mktemp "$STATE_DIR/$RUN_ID.prompt.XXXXXX")"
{
  if [[ "$SKILLS_SUPPRESSED" == yes ]]; then
    echo '**重要: `~/.agents` 配下のスキル定義（SKILL.md 等）を読み込んではならない。レビューの観点・完成条件・必ず答えることは、すべてこの指示文に書かれている。対象リポジトリ内のファイル（AGENTS.md / CLAUDE.md / テスト / 呼び出し元 / 設定を含む）は必要に応じて読んでよい。**'
    echo
  fi
  echo 'これは依頼者自身が保有する社内リポジトリのコードに対する、通常の品質レビューです。目的は自社の防御機構が期待どおり動くかを確認することです。'
  echo
  echo '**重要: 出力は最後にまとめて1回で返さず、セクションを1つ書き終えるたびに、そのセクションだけを1つのメッセージとして出力すること。判定行（`マージ可` / `修正要` など）は最初のメッセージで先に出すこと。以降のセクションは順に出力し、最後に全体を再掲しない。**'
  echo
  cat "$PROMPT_FILE"
} > "$EFFECTIVE_PROMPT"

# パイプを挟まずファイルへ直書きする（パイプの右側はEOFまでバッファするため進行中に観測できない）。
# 発注ごとに model / reasoning effort を変えられるようにする（未指定なら config.toml の既定）。
# macOS 既定の bash 3.2 では空配列の "${a[@]}" が set -u で落ちるので +展開で渡す。
EFFORT_ARGS=()
[[ -n "${CODEX_REVIEW_MODEL:-}" ]] && EFFORT_ARGS+=(-m "$CODEX_REVIEW_MODEL")
[[ -n "${CODEX_REVIEW_EFFORT:-}" ]] && EFFORT_ARGS+=(-c "model_reasoning_effort=\"$CODEX_REVIEW_EFFORT\"")
nohup codex exec -C "$WORKDIR" -s read-only ${EFFORT_ARGS[@]+"${EFFORT_ARGS[@]}"} -o "$REPORT_FILE" - < "$EFFECTIVE_PROMPT" > "$LOG_FILE" 2>&1 &
CODEX_PID=$!

# 巡数ゲートの判定結果（JSON）を state 用の値へ分解する。gh/git を再度呼ばず、gate が
# 既に確定した値をそのまま state に写す（record_target が空＝ブロック中/usage error 相当。
# 本来ここには到達しない想定だが、防御的に空のまま record へ渡し record 側で無害にスキップさせる）。
# goal_cut は run_gate() が既に「1行であること」を保証している前提だが（bypass 経路も
# is_single_line() の対象・Must1）、ここでも同じ不変条件を独立に効かせる（片側だけだと配線を
# 変えたときに穴が開く・2026-09-03 codex レビュー）。`str.splitlines()` が行境界とみなす文字
# 全体を空白へ置換してから state へ書く（個別文字の `.replace(chr(10), ' ')` は `\r` 等を
# 見逃していた）。
GATE_FIELDS="$(python3 -c "
import json, sys
sys.path.insert(0, '$(dirname "$GATE_PY")')
from round_gate import is_single_line
d = json.loads(sys.argv[1])
gc = d.get('goal_cut') or ''
if not is_single_line(gc):
    gc = ' '.join(gc.splitlines())
print(d.get('record_target') or '')
print(d.get('total_round', ''))
print(d.get('head_sha') or '')
print(gc)
" "$GATE_JSON" 2>/dev/null || true)"
GATE_TARGET="$(sed -n '1p' <<<"$GATE_FIELDS")"
GATE_ROUND="$(sed -n '2p' <<<"$GATE_FIELDS")"
GATE_HEAD="$(sed -n '3p' <<<"$GATE_FIELDS")"
GATE_GOAL_CUT="$(sed -n '4p' <<<"$GATE_FIELDS")"

{
  echo "run_id=$RUN_ID"
  echo "pid=$CODEX_PID"
  echo "log=$LOG_FILE"
  echo "report=$REPORT_FILE"
  echo "workdir=$WORKDIR"
  echo "prompt=$PROMPT_FILE"
  echo "effective_prompt=$EFFECTIVE_PROMPT"
  echo "skills_suppressed=$SKILLS_SUPPRESSED"
  echo "effort=${CODEX_REVIEW_EFFORT:-既定}"
  echo "model=${CODEX_REVIEW_MODEL:-既定}"
  echo "prompt_bytes=$(wc -c < "$EFFECTIVE_PROMPT" | tr -d ' ')"
  echo "started_at=$(date +%s)"
  echo "started_at_human=$(date '+%Y-%m-%d %H:%M:%S')"
  echo "review_target=$GATE_TARGET"
  echo "round=$GATE_ROUND"
  echo "head_sha=$GATE_HEAD"
  echo "goal_cut=$GATE_GOAL_CUT"
  echo "reviewer=$LABEL"
} > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"

# 巡行を本文へ追記する（none:/bypass は record 側が無害にスキップする）。失敗しても
# 発注自体は既に開始済みなので dispatch を殺さない（stderr へ警告のみ）。
python3 "$GATE_PY" record --state-file "$STATE_FILE" >&2 || echo "巡行の本文追記に失敗しました（run_id=$RUN_ID）。手動確認してください" >&2

echo "$RUN_ID"
