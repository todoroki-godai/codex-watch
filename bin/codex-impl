#!/usr/bin/env bash
# codex exec を「書き込み可（専用権限プロファイル）」で起動し、codex-review と同じ状態ファイルを残す。
#
# なぜ要るか: 工程ルール（~/.claude/rules/pipeline-routing.md）は実装の主力を Codex と定めて
# いるが、起動役は codex-review しか無く `-s read-only` が焼き込まれていたため、実装では毎回
# CC ワーカーへ戻っていた（2026-08-25 ユーザー指摘）。本コマンドはその欠けを埋める。
#
# 契約（pipeline-routing.md「Codex を実装で起動する契約」）:
#   - サンドボックス = codex-impl-dev（:workspace 継承）
#   - 作業先 = 頭が用意した worktree の絶対パスを -C で渡す
#   - Codex は commit まで。push / PR / マージは頭（人間）が行う
#   - 完了判定はプロセス終了と報告の終端マーカーの両方。log の中身だけで判定しない
#
# 安全ガード: 対象が linked worktree でない場合（= 共有 checkout / main 作業コピー）は拒否する。
#   共有 checkout はユーザーの実行環境そのもの（~/.claude/rules/live-checkout-guard.md）で、
#   ここを書き換えるとレビュー未了のコードが即座に本番稼働する。
#   意図的に無効化する場合のみ CODEX_IMPL_ALLOW_MAIN=1 を明示する。
#
# 使い方:
#   codex-impl <worktree絶対パス> <プロンプトファイル> [ラベル]
# 出力:
#   run id を1行で返す。以降 codex-status <run id> / codex-watch <run id> で観測する。
set +x  # Credentials must never enter shell trace, including bash -x invocations.
set -euo pipefail

# Only the preflight receives the reason. Keep it out of dispatch and other helpers' environments.
unset ASTRA_REASON_INPUT ASTRA_REASON MODEL_PREFLIGHT
ASTRA_REASON_INPUT="${CODEX_ASTRA_REASON:-}"
unset CODEX_ASTRA_REASON

WORKDIR="${1:?worktree の絶対パスを指定してください}"
PROMPT_FILE="${2:?プロンプトファイルのパスを指定してください}"
LABEL="${3:-impl}"

[[ "$WORKDIR" = /* ]] || { echo "作業先は絶対パスで指定してください: $WORKDIR" >&2; exit 2; }
[[ -d "$WORKDIR" ]] || { echo "作業先がありません: $WORKDIR" >&2; exit 2; }
[[ -f "$PROMPT_FILE" ]] || { echo "プロンプトファイルがありません: $PROMPT_FILE" >&2; exit 2; }


# Inspect the file itself, before config/credentials/launch; never parse the caller's Bash.
python3 - "$PROMPT_FILE" <<'PYRECEIPT'
import sys
import re
import json
import hashlib
import os
from datetime import datetime
from pathlib import Path

try:
    prompt_bytes = Path(sys.argv[1]).read_bytes()
    body = prompt_bytes.decode('utf-8')
    if '\0' in body:
        raise ValueError
    fields = {}
    for key in ('直しの出所', '受領①累計', '受領②件数', '受領③7段'):
        fields[key] = [line[len(key) + 1:].strip() for line in body.splitlines()
                       if line.startswith(key + ':')]
    source = fields['直しの出所']
    reason = ''
    if len(source) != 1 or not source[0]:
        reason = '直しの出所: は行頭に、空でない値つきで1行だけ必要です。'
    elif not source[0].startswith(('なし', 'レビュー')):
        reason = '直しの出所は「なし」か「レビュー」で始めてください。'
    elif source[0].startswith('なし'):
        source_line = next(i for i, line in enumerate(body.splitlines())
                           if line.startswith('直しの出所:'))
        match = re.search(r'巡[0-9]|指摘を反映', '\n'.join(body.splitlines()[source_line + 1:]))
        if match:
            reason = '出所を「レビュー…」に直し、受領の3行を書く必要があります。語で見ているだけ・言い換えは通る。'
            log = Path.home() / '.codex-watch' / 'receipt-gate-stops.log'
            stops = log.parent / 'receipt-gate-stops'
            stops.mkdir(parents=True, exist_ok=True, mode=0o700)
            stopped_at = datetime.now().astimezone()
            sha256 = hashlib.sha256(prompt_bytes).hexdigest()
            snapshot = stops / f'{stopped_at.strftime("%Y%m%dT%H%M%S.%f%z")}-{sha256[:12]}.md'
            with os.fdopen(os.open(snapshot, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), 'wb') as stream:
                stream.write(prompt_bytes)
            with log.open('a', encoding='utf-8') as stream:
                stream.write(json.dumps({'time': stopped_at.isoformat(),
                                         'prompt': str(Path(sys.argv[1]).resolve()),
                                         'match': match.group(),
                                         'snapshot': str(snapshot), 'sha256': sha256}, ensure_ascii=False) + '\n')
    elif source[0].startswith('レビュー'):
        if any(len(fields[key]) != 1 or not fields[key][0] for key in fields if key != '直しの出所'):
            reason = 'レビューの直しには、空でない受領の3行がそれぞれ1行必要です。'
except (OSError, UnicodeError, ValueError):
    reason = '依頼文の読取・写しの保存または停止ログの記録に失敗しました（UTF-8必須・NUL不可）。'
if reason:
    print('拒否: ' + reason + """
~/.claude/rules/review-receipt.md の3手順を、直しの依頼前に済ませてください:
①起点からの累計と未追跡 ②各[Must]の危険の件数・母集団・取得日 ③足す前に7段。
行頭・字下げなし・半角コロンで書く例:
直しの出所: レビュー巡1（対象版・出所）
受領①累計: 起点abc123から1 commit・2ファイル・+10/-2、未追跡0件
受領②件数: M1=対象10件中2件（YYYY-MM-DD取得）
受領③7段: M1は㋑、既存の起動口を再利用
レビュー由来でなければ「直しの出所: なし（新規実装）」を1行。
既知の書き方だけを見る・自己申告なので迂回できる（捕まえるのは書き忘れ）。
「なし」の本文は 巡[0-9]|指摘を反映 で検査します。語で見ているだけ・言い換えは通る。""", file=sys.stderr)
    sys.exit(2)
PYRECEIPT

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/_codex_common.sh
source "$SCRIPT_DIR/_codex_common.sh"
check_codex_summary_issue

# --- 安全ガード: 共有 checkout / main 作業コピーへの書き込みを拒否する ---
GIT_DIR_ABS="$(git -C "$WORKDIR" rev-parse --absolute-git-dir 2>/dev/null || true)"
GIT_COMMON_ABS="$(git -C "$WORKDIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"

if [[ "${CODEX_IMPL_ALLOW_MAIN:-0}" != "1" ]]; then
  if [[ -z "$GIT_DIR_ABS" ]]; then
    echo "作業先が git リポジトリではありません: $WORKDIR" >&2
    echo "実装は頭が用意した worktree で行ってください（git worktree add）。" >&2
    exit 3
  fi
  if [[ "$GIT_DIR_ABS" == "$GIT_COMMON_ABS" ]]; then
    echo "拒否: 作業先が linked worktree ではありません（共有 checkout / main 作業コピーの疑い）: $WORKDIR" >&2
    echo "  git-dir=$GIT_DIR_ABS" >&2
    echo "  共有 checkout はユーザーの実行環境そのもので、書き換えると未レビューのコードが即稼働します。" >&2
    echo "  対処: git -C <repo> worktree add -b <branch> <絶対path> origin/<既定branch> で隔離してから渡す。" >&2
    echo "  意図的に無効化する場合のみ CODEX_IMPL_ALLOW_MAIN=1 を付けて再実行してください。" >&2
    exit 3
  fi
fi

# --- 下準備ゲート: node_modules の実体が無い worktree への投入を拒否する ---
#   実測（2026-09-09）: 部品一式が入っていない worktree を渡した結果、Codex の実行環境が
#   外部取得不可でログに ENOTCACHED が出るだけで静かに待ち続け、2時間12分 1ファイルも書けな
#   かった（赤にならないので気づけない）。判定は「実体の有無」のみで、パッケージ名の列挙や
#   バージョン照合はしない（名前で同一性を判定する検査は回避形を無限に構成できるため・
#   ~/.claude/rules/verify-checks-by-breaking.md）。空ディレクトリが残っている実例があるため
#   ディレクトリの存在だけでは通さず、中身が1件以上あることを実測する。
if [[ "${CODEX_IMPL_ALLOW_MISSING_NODE_MODULES:-0}" != "1" ]]; then
  NODE_MODULES_DIR="$WORKDIR/node_modules"
  if [[ ! -d "$NODE_MODULES_DIR" ]] || [[ -z "$(ls -A "$NODE_MODULES_DIR" 2>/dev/null)" ]]; then
    echo "拒否: 下準備未完了（node_modules の実体がありません）: $NODE_MODULES_DIR" >&2
    echo "  これに静かに Codex を投入すると、外部取得不可の環境ではエラーにならず待ち続けるだけになります。" >&2
    echo "  対処: 次を実行してから再度 codex-impl を起動してください。" >&2
    echo "    pnpm --dir \"$WORKDIR\" install --frozen-lockfile" >&2
    echo "  意図的に無効化する場合のみ CODEX_IMPL_ALLOW_MISSING_NODE_MODULES=1 を付けて再実行してください。" >&2
    exit 4
  fi
fi

# モデルの明示を検査する。
MODEL_PREFLIGHT="$(CODEX_ASTRA_REASON="$ASTRA_REASON_INPUT" python3 "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/codex_dispatch_model.py" \
  "$WORKDIR" "${CODEX_IMPL_MODEL-}" CODEX_IMPL_MODEL)" || exit 2
ASTRA_REASON="${MODEL_PREFLIGHT%%$'\n'*}"
REQUESTED_MODEL="${MODEL_PREFLIGHT#*$'\n'}"
unset ASTRA_REASON_INPUT MODEL_PREFLIGHT

# AWS の接続先（AWS_PROFILE / --profile）は依頼文に書かれていてもよい。
# PJ の宣言で dev または docs 読み取り専用の1組だけを渡す。
# 2026-11-06 までは依頼文を文字列で検査して拒否していたが、説明文や削除指示まで止める一方で
# 行を分けた書き方は通ってしまい、文字列検査では両立しないため撤去した。

prepare_codex_aws_account

# Fail closed before credential preparation or Codex launch; output never includes values.
python3 "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/codex_impl_aws.py" --check-config "$WORKDIR"

STATE_DIR="${CODEX_WATCH_DIR:-$HOME/.codex-watch}"
mkdir -p "$STATE_DIR"
prepare_codex_github_account

# 行頭の見込み欄を優先し、なければ本文の最初の一致を読む。環境値は空でも優先する。
ESTIMATE_MIN="$(python3 - "$PROMPT_FILE" <<'PYESTIMATE'
import os, re, sys
from pathlib import Path
value = os.environ.get('CODEX_IMPL_ESTIMATE_MIN')
if value is None:
    body = Path(sys.argv[1]).read_text(encoding='utf-8')
    label = r'見込み[:：]\s*'
    heading = re.search(r'^(?:## )?' + label + r'(.*)$', body, re.MULTILINE)
    match = (re.match(r'約?(-?[0-9]+)\s*分', heading.group(1)) if heading else
             re.search(label + r'約?([0-9]+)\s*分', body))
    value = match.group(1) if match else ''
if not re.fullmatch(r'-?[0-9]+', value):
    print('警告: 見込みが未指定または整数でないため estimate_min は空です。', file=sys.stderr)
    value = ''
print(value)
PYESTIMATE
)"


RUN_ID="$(codex_label_with_issue "$LABEL")-$(date +%Y%m%d-%H%M%S)-$$"
LOG_FILE="$STATE_DIR/$RUN_ID.log"
STATE_FILE="$STATE_DIR/$RUN_ID.state"
# 最終メッセージだけを別ファイルへ落とす（log 全文を読まずに結論だけ取るため）。
REPORT_FILE="$STATE_DIR/$RUN_ID.report"

LAUNCH_PROMPT="$PROMPT_FILE"
BROWSER_PORT=""
if [[ "${CODEX_IMPL_NO_BROWSER:-0}" != "1" ]]; then
  BROWSER_DIR="$WORKDIR/_work/codex-browser/$RUN_ID"
  BROWSER_PORT="$(python3 - "$PROMPT_FILE" "$BROWSER_DIR" "$SCRIPT_DIR/../templates/browser-cdp.md" <<'PYBROWSER'
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import urlsplit

prompt_file, profile, template = map(Path, sys.argv[1:])
prompt = prompt_file.read_bytes()
body = prompt.decode('utf-8').lower()
words = ('playwright', 'chromium', 'connectovercdp', 'style-diff', 'run.sh dev', 'run.sh stg',
         'https://dev.', 'https://stg.', '見本照合', '撮影', 'スクリーンショット', 'screenshot')
if not any(word in body for word in words):
    sys.exit(0)
if 'connectovercdp' in body and re.search(r'127\.0\.0\.1:[0-9]+', body):
    sys.exit(0)

if 'CODEX_IMPL_CHROMIUM' in os.environ:
    chromium = Path(os.environ['CODEX_IMPL_CHROMIUM'])
else:
    cache = Path.home() / 'Library/Caches/ms-playwright'
    revisions = [path for path in cache.glob('chromium_headless_shell-*')
                 if path.is_dir() and re.fullmatch(r'[0-9]+', path.name.rsplit('-', 1)[1])]
    revision = max(revisions, key=lambda path: int(path.name.rsplit('-', 1)[1]), default=None)
    chromium = next(revision.glob('*/chrome-headless-shell'), None) if revision else None
if chromium is None or not chromium.is_file() or not os.access(chromium, os.X_OK):
    sys.exit('Chromium の実行ファイルがありません。CODEX_IMPL_CHROMIUM で指定してください。')

try:
    block = template.read_text(encoding='utf-8').split('## 依頼文に貼る定型\n', 1)[1].split('```', 2)[1]
    block = '\n'.join(line for line in block.strip('\n').splitlines()
                      if not line.startswith('- （ログインが要る画面のときだけ足す）'))
    # A pre-existing profile could contain a DevToolsActivePort from a different run.
    profile.mkdir(mode=0o700, parents=True)
    log = profile / 'chrome.log'
    with log.open('wb') as output:
        browser = subprocess.Popen(
            ['nohup', 'timeout', '-k', '10', '5400', str(chromium.absolute()),
             '--remote-debugging-port=0', '--remote-debugging-address=127.0.0.1',
             f'--user-data-dir={profile}', '--no-first-run', 'about:blank'],
            stdin=subprocess.DEVNULL, stdout=output, stderr=subprocess.STDOUT,
            start_new_session=True,
        )

    marker = profile / 'DevToolsActivePort'
    deadline = time.monotonic() + 10
    while deadline - time.monotonic() >= 0.001:
        try:
            lines = marker.read_text(encoding='utf-8').splitlines()
        except FileNotFoundError:
            lines = []
        if len(lines) >= 2 and lines[1]:
            port, browser_path = lines[:2]
            if not re.fullmatch(r'[0-9]{1,5}', port) or not 1 <= int(port) <= 65535:
                sys.exit(f'Chromium のポートが不正です: {marker}')
            remaining = deadline - time.monotonic()
            if remaining < 0.001:
                continue
            with subprocess.Popen(
                ['curl', '-q', '--silent', '--fail', '--noproxy', '*',
                 '--max-time', f'{remaining:.3f}', f'http://127.0.0.1:{port}/json/version'],
                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            ) as request:
                response, _ = request.communicate()
            if request.returncode == 0 and time.monotonic() < deadline:
                remote_path = urlsplit(json.loads(response)['webSocketDebuggerUrl']).path
                if remote_path != browser_path:
                    sys.exit(f'Chromium のブラウザパスが一致しません: {marker}')
                break
        if browser.poll() is not None:
            sys.exit(f'Chromium が準備前に終了しました: {log}')
        time.sleep(0.05)
    else:
        sys.exit(f'Chromium の準備が10秒以内に完了しませんでした: {log}')
    suffix = block.replace('<ポート>', port).replace('<許す URL の一覧>', 'この依頼文に書かれた URL だけ')
    (profile / 'prompt.md').write_bytes(prompt + ('\n\n' + suffix + '\n').encode('utf-8'))
    print(port)
except (OSError, ValueError, KeyError, IndexError, TypeError, AttributeError) as error:
    sys.exit(f'Chromium の準備に失敗しました: {error}')
PYBROWSER
)"
  if [[ -n "$BROWSER_PORT" ]]; then LAUNCH_PROMPT="$BROWSER_DIR/prompt.md"; fi
fi

# Dedicated permission profile: serialize paths as TOML strings, including quotes/backslashes.
SANDBOX_ARGS=(-c 'default_permissions="codex-impl-dev"'
  -c 'permissions.codex-impl-dev.extends=":workspace"'
  -c 'permissions.codex-impl-dev.network.enabled=true'
  -c 'shell_environment_policy.inherit="all"'
  -c 'shell_environment_policy.ignore_default_excludes=true'
  -c 'shell_environment_policy.set.AWS_PROFILE="codex-dev"')
FILESYSTEM="$(python3 - "$GIT_COMMON_ABS" "$GIT_DIR_ABS" <<'PYFS'
import json, sys
paths = dict.fromkeys(p for p in sys.argv[1:] if p)
if any(not p.startswith('/') for p in paths):
    sys.exit('git directory must be absolute')
print('permissions.codex-impl-dev.filesystem={"~/.aws"="deny"' +
      ''.join(', ' + json.dumps(p, ensure_ascii=False) + '="write"' for p in paths) + '}')
PYFS
)"
SANDBOX_ARGS+=(-c "$FILESYSTEM")
# Capture only in process memory. Failure to run the helper stops launch, never inherits keys.
AWS_ENV_UPDATES="$(python3 "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/codex_impl_aws.py" "$CODEX_AWS_ACCOUNT")"
eval "$AWS_ENV_UPDATES"
unset AWS_ENV_UPDATES

# 確定したモデルを固定する。effort は未指定なら medium、空なら Codex の設定に従う。
CODEX_CLI_ARGS=()
REQUESTED_EFFORT="$(sanitize_single_line "${CODEX_IMPL_EFFORT-medium}")"
CODEX_CLI_ARGS+=(-m "$REQUESTED_MODEL")
[[ -n "$REQUESTED_EFFORT" ]] && CODEX_CLI_ARGS+=(-c "model_reasoning_effort=\"$REQUESTED_EFFORT\"")

prepare_codex_launch_skills "$WORKDIR" no exec -C "$WORKDIR" \
  ${SANDBOX_ARGS[@]+"${SANDBOX_ARGS[@]}"} ${CODEX_CLI_ARGS[@]+"${CODEX_CLI_ARGS[@]}"} \
  ${CODEX_GITHUB_ARGS[@]+"${CODEX_GITHUB_ARGS[@]}"} -o "$REPORT_FILE" -

printf 'モデル: %s（判断の要らない機械作業は gpt-6-luna、通常は terra、大事な場面・難しい作業は sol、全体の設計・設計し直しは astra（理由の指定が必要）を CODEX_IMPL_MODEL で指定）\n' "$REQUESTED_MODEL" >&2
# 先に原本を stdin に開き、注記と原本を順に渡す。出力は進行中に読めるようログへ直書きする。
nohup "$CODEX_LAUNCH_EXECUTABLE" exec -C "$WORKDIR" ${SANDBOX_ARGS[@]+"${SANDBOX_ARGS[@]}"} ${CODEX_CLI_ARGS[@]+"${CODEX_CLI_ARGS[@]}"} ${CODEX_GITHUB_ARGS[@]+"${CODEX_GITHUB_ARGS[@]}"} -o "$REPORT_FILE" - \
  < "$LAUNCH_PROMPT" < <(printf '%s\n' '手元で回す試験は、変えたファイルとその近くの試験・依存先込みの lint/typecheck だけ。パッケージ全体・リポジトリ全体の試験は頭が AWS で回すので回さない（依頼文が明示的に求めた場合を除く）。' && cat && printf '\n' && { cat "$SCRIPT_DIR/../templates/hash-check.md" 2>/dev/null || printf '%s\n' '警告: ハッシュ照合のテンプレートを読めません。' >&2; }) \
  > "$LOG_FILE" 2>&1 &
CODEX_PID=$!

# 実効値（実際に起動された model / effort）はここでは解決しない・待たない。
# state には要求値（requested_*）だけを即時に書き、run id を待たせず返す。
# 実効値はログが出揃ってから「読み手側」（codex-status / codex-watch）が
# extract_codex_log_header() で read 時に導出する（2026-09-08 codex レビュー巡2 [Must]1）。

{
  echo "run_id=$RUN_ID"
  echo "pid=$CODEX_PID"
  echo "log=$LOG_FILE"
  echo "report=$REPORT_FILE"
  echo "workdir=$WORKDIR"
  echo "prompt=$PROMPT_FILE"
  if [[ -n "$BROWSER_PORT" ]]; then printf 'browser_port=%s\n' "$BROWSER_PORT"; fi
  echo "mode=workspace-write"
  echo "writable_git_common=${GIT_COMMON_ABS:-}"
  echo "aws=$CODEX_IMPL_AWS_STATE"
  echo "aws_expiration=$CODEX_IMPL_AWS_EXPIRATION"
  codex_github_account_state
  codex_summary_state
  printf '%s\n' "$CODEX_LAUNCH_SKILLS_STATE"
  echo "requested_model=$REQUESTED_MODEL"
  if [[ -n "$ASTRA_REASON" ]]; then printf 'astra_reason=%s\n' "$ASTRA_REASON"; fi
  echo "requested_effort=$REQUESTED_EFFORT"
  echo "estimate_min=$ESTIMATE_MIN"
  echo "started_at=$(date +%s)"
  echo "started_at_human=$(date '+%Y-%m-%d %H:%M:%S')"
} > "$STATE_FILE"

echo "$RUN_ID"
