# codex-impl 専用。dev/stg は dev 鍵、docs の2別名は照合済み assume-role 鍵だけを使う。
# docs は --profile を明示する。AWS_PROFILE だけでは dev の標準環境変数が優先される。
# 本番の名前は定義しない。~/.aws は読めない。鍵を引数へ展開しない。
[profile codex-dev]
region = ap-northeast-1

[profile aws-updater-index-stg]
region = ap-northeast-1
credential_process = /bin/sh -c 'if [ -z "$AWS_ACCESS_KEY_ID" ] || [ -z "$AWS_SECRET_ACCESS_KEY" ] || [ -z "$AWS_SESSION_TOKEN" ]; then echo "codex-impl: dev の一時鍵が環境にありません（頭の aws-updater-index-stg が切れている可能性）" >&2; exit 1; fi; printf "{\"Version\":1,\"AccessKeyId\":\"%s\",\"SecretAccessKey\":\"%s\",\"SessionToken\":\"%s\"}" "$AWS_ACCESS_KEY_ID" "$AWS_SECRET_ACCESS_KEY" "$AWS_SESSION_TOKEN"'

[profile aws-updater-bc-dev]
region = ap-northeast-1
credential_process = python3 -c 'import json,os,sys; names=("ACCESS_KEY_ID","SECRET_ACCESS_KEY","SESSION_TOKEN"); values=[os.environ.get("CODEX_AWS_DOCS_"+n,"") for n in names]; all(values) or sys.exit("docs-platform の読み取り鍵がありません"); print(json.dumps(dict(zip(("Version","AccessKeyId","SecretAccessKey","SessionToken"),(1,*values)))))'

[profile codex-docs-ro]
region = ap-northeast-1
credential_process = python3 -c 'import json,os,sys; names=("ACCESS_KEY_ID","SECRET_ACCESS_KEY","SESSION_TOKEN"); values=[os.environ.get("CODEX_AWS_DOCS_"+n,"") for n in names]; all(values) or sys.exit("docs-platform の読み取り鍵がありません"); print(json.dumps(dict(zip(("Version","AccessKeyId","SecretAccessKey","SessionToken"),(1,*values)))))'
