# codex-impl が Codex へ渡す唯一の AWS 設定（~/.aws は読めない）。
# 鍵は codex_impl_aws.py が環境変数で渡す dev（669126230735）の一時鍵だけ。
#
# codex-dev 以外の2つは、依頼文や手順書によく書かれる dev・stg 用の名前の別名。
# 同じ dev の一時鍵へ向く。これが無いと、依頼文が接続先を指定した時点で
# "The config profile (...) could not be found" で必ず失敗する（同型の空振りが4回）。
# 本番の名前（aws-updater-index-prod）は意図的に定義しない＝指定されたら失敗する。
#
# AWS_PROFILE= で指定された場合は環境変数の鍵がそのまま使われるが、
# --profile で指定された場合はコマンド行が優先して環境変数の鍵を見ないため、
# credential_process で環境変数から取り出し直す（鍵の値は引数に出さない）。
[profile codex-dev]
region = ap-northeast-1

[profile aws-updater-index-stg]
region = ap-northeast-1
credential_process = /bin/sh -c 'printf "{\"Version\":1,\"AccessKeyId\":\"%s\",\"SecretAccessKey\":\"%s\",\"SessionToken\":\"%s\"}" "$AWS_ACCESS_KEY_ID" "$AWS_SECRET_ACCESS_KEY" "$AWS_SESSION_TOKEN"'

[profile aws-updater-bc-dev]
region = ap-northeast-1
credential_process = /bin/sh -c 'printf "{\"Version\":1,\"AccessKeyId\":\"%s\",\"SecretAccessKey\":\"%s\",\"SessionToken\":\"%s\"}" "$AWS_ACCESS_KEY_ID" "$AWS_SECRET_ACCESS_KEY" "$AWS_SESSION_TOKEN"'
